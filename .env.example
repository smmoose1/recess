# Copy via Secret Manager (preferred):
#   bash scripts/pull-secrets.sh
#
# Or fill placeholders manually into apps/web/.env.local
# Never commit real keys. Firebase browser keys are still public in client JS
# after build — protect data with Auth + Firestore rules + API key referrer
# restrictions. Server-only secrets belong in Google Secret Manager.

NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=recess-app-nyc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=recess-app-nyc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=recess-app-nyc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=978707183296
NEXT_PUBLIC_FIREBASE_APP_ID=1:978707183296:web:431774bd04abf827711f25
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
